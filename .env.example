# =========================
# App
# =========================
NEXT_PUBLIC_APP_URL=https://aiabw.com
NEXT_PUBLIC_APP_NAME=AIABW
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh-CN
NEXT_PUBLIC_CONTACT_EMAIL=hello@aiabw.com

# =========================
# Supabase
# =========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =========================
# LLM — 免费 DeepSeek / Pro 通义千问
# =========================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=your_qwen_dashscope_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus

# 可选：日级防刷上限
LLM_FREE_DAILY_CALL_CAP=3
LLM_PRO_DAILY_CALL_CAP=500
LLM_FREE_DAILY_COST_CAP_USD=0.08
LLM_PRO_DAILY_COST_CAP_USD=5

# =========================
# Payments (NOWPayments)
# =========================
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAYOUT_EMAIL=
NOWPAYMENTS_PAYOUT_PASSWORD=

# =========================
# Cron & Email
# =========================
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=AIABW <noreply@aiabw.com>
