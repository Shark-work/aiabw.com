# Public Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

# Private server-only secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App-level config
NEXT_PUBLIC_APP_NAME=AIABW
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh-CN
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional: used by server-side utilities / auth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TODO: Add provider-specific keys only when a feature needs them.
