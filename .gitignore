# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================
# Secrets & credentials — NEVER commit these
# =========================
# Ignore all env variants first, then allow safe templates (no real keys)
.env*
!.env.example
!.env.sample
!.env.template
vercel.env

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
service-account*.json
**/secrets/
# .npmrc may contain registry auth tokens
.npmrc

# =========================
# Dependencies
# =========================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================
# Next.js / build output
# =========================
/.next/
/out/
/build
/dist
/.turbo
/.swc/

# =========================
# Testing & coverage
# =========================
/coverage
*.lcov

# =========================
# Logs & debug
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# =========================
# Vercel / Supabase local
# =========================
.vercel
supabase/.branches
supabase/.temp
supabase/.env

# =========================
# OS & editor junk
# =========================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# =========================
# TypeScript
# =========================
*.tsbuildinfo
next-env.d.ts

# =========================
# Misc cache
# =========================
.cache
.parcel-cache
.eslintcache
